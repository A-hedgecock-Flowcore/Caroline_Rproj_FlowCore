# Executive summary

```{r}
#| label: executive-summary

if (is.null(pipeline_summary)) {
  cat(
    "⚠️ `pipeline_summary.rds` was not found. ",
    "The report may be rendering before the pipeline has completed."
  )
} else if (identical(pipeline_summary$status, "completed")) {
  cat("✅ The analysis pipeline completed successfully.")
} else {
  cat("❌ The analysis pipeline did not complete successfully.")
}
```

```{r}
#| label: run-overview

run_overview <- tibble::tibble(
  Metric = c(
    "Pipeline status",
    "Start time",
    "End time",
    "Duration (minutes)",
    "Project root"
  ),
  Value = if (is.null(pipeline_summary)) {
    c(
      "Unavailable",
      "Unavailable",
      "Unavailable",
      "Unavailable",
      normalizePath(".", winslash = "/", mustWork = TRUE)
    )
  } else {
    c(
      status_badge(pipeline_summary$status),
      as.character(pipeline_summary$start_time),
      as.character(pipeline_summary$end_time),
      format(round(pipeline_summary$duration_minutes, 2)),
      pipeline_summary$project_root
    )
  }
)

knitr::kable(run_overview)
```

# Pipeline status

## Status summary

```{r}
#| label: status-summary

status_summary <- tibble::tibble(
  Stage = c(
    "Patient AF extraction",
    "Patient unmixing",
    "Nonpatient unmixing",
    "Gating",
    "Patient compensAID",
    "Control compensAID"
  ),
  Status = c(
    if (is.null(af_status)) {
      "Unavailable"
    } else if (count_status(af_status, "flagged") > 0) {
      "⚠️ Review"
    } else {
      "✅ No flags"
    },
    if (is.null(patient_unmixing_status)) {
      "Unavailable"
    } else if (
      count_status(patient_unmixing_status, "flagged") > 0 ||
        count_status(patient_unmixing_status, "failed") > 0
    ) {
      "⚠️ Review"
    } else {
      "✅ No flags"
    },
    if (is.null(nonpatient_unmixing_status)) {
      "Unavailable"
    } else if (count_status(nonpatient_unmixing_status, "failed") > 0) {
      "⚠️ Review"
    } else {
      "✅ No failures"
    },
    if (is.null(gating_plots)) {
      "Unavailable"
    } else {
      "✅ Results available"
    },
    if (is.null(patient_compensaid_results)) {
      "Unavailable"
    } else if (any(patient_compensaid_summary$flagged_pairs > 0)) {
      "⚠️ Review"
    } else {
      "✅ No flagged pairs"
    },
    if (is.null(controls_compensaid_results)) {
      "Unavailable"
    } else if (any(controls_compensaid_summary$flagged_pairs > 0)) {
      "⚠️ Review"
    } else {
      "✅ No flagged pairs"
    }
  )
)

knitr::kable(status_summary)
```

