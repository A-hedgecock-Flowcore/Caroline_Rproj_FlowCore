<style>
.qc-carousel {
  position: relative;
  width: 100%;
  margin: 1rem 0 2rem 0;
  padding: 0 3.5rem;
  box-sizing: border-box;
}

.qc-carousel-window {
  overflow: hidden;
  width: 100%;
  border: 1px solid #d9d9d9;
  border-radius: 0.5rem;
  background: #fafafa;
}

.qc-carousel-track {
  display: flex;
  transition: transform 0.3s ease-in-out;
}

.qc-carousel-slide {
  min-width: 100%;
  box-sizing: border-box;
  padding: 0.75rem;
  text-align: center;
}

.qc-carousel-slide img {
  display: block;
  max-width: 100%;
  height: 32rem;
  object-fit: contain;
  margin: 0 auto;
}

.qc-carousel-caption {
  margin-top: 0.5rem;
  font-size: 0.85rem;
  color: #555;
  overflow-wrap: anywhere;
}

.qc-carousel-button {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  z-index: 2;
  width: 2.5rem;
  height: 2.5rem;
  border: none;
  border-radius: 50%;
  background: #2c3e50;
  color: white;
  font-size: 1.5rem;
  cursor: pointer;
}

.qc-carousel-button:hover {
  background: #1a252f;
}

.qc-carousel-button.previous {
  left: 0.25rem;
}

.qc-carousel-button.next {
  right: 0.25rem;
}

.qc-carousel-counter {
  margin-top: 0.5rem;
  text-align: center;
  color: #666;
  font-size: 0.85rem;
}
</style>

<script>
function qcCarouselMove(carouselId, direction) {
  const carousel = document.getElementById(carouselId);

  if (!carousel) {
    return;
  }

  const track = carousel.querySelector(".qc-carousel-track");
  const slides = carousel.querySelectorAll(".qc-carousel-slide");
  const counter = carousel.querySelector(".qc-carousel-counter");

  if (slides.length === 0) {
    return;
  }

  let currentIndex = Number(carousel.dataset.currentIndex || 0);

  currentIndex = currentIndex + direction;

  if (currentIndex < 0) {
    currentIndex = slides.length - 1;
  }

  if (currentIndex >= slides.length) {
    currentIndex = 0;
  }

  carousel.dataset.currentIndex = currentIndex;
  track.style.transform = "translateX(-" + (currentIndex * 100) + "%)";
  counter.textContent = (currentIndex + 1) + " / " + slides.length;
}
</script>

```{r}
#| label: setup

required_report_packages <- c(
  "dplyr",
  "readr",
  "tibble",
  "purrr",
  "stringr",
  "knitr",
  "fs",
  "htmltools"
)

missing_report_packages <- required_report_packages[
  !vapply(
    required_report_packages,
    requireNamespace,
    quietly = TRUE,
    FUN.VALUE = logical(1)
  )
]

if (length(missing_report_packages) > 0) {
  stop(
    "Missing packages required to render the QC report: ",
    paste(missing_report_packages, collapse = ", ")
  )
}

output_folder <- file.path("Output")

if (!dir.exists(output_folder)) {
  stop(
    "Output folder does not exist: ",
    output_folder,
    "\nRun AnalysisPipeline.R before rendering the QC report"
  )
}

variants_folder <- file.path(
  output_folder,
  "variants"
)

autofluorescence_folder <- file.path(
  output_folder,
  "figure_autofluorescence"
)

scatter_folder <- file.path(
  output_folder,
  "figure_scatter"
)

similarity_folder <- file.path(
  output_folder,
  "figure_similarity_heatmap"
)

spectra_folder <- file.path(
  output_folder,
  "figure_spectra"
)

clean_controls_folder <- file.path(
  output_folder,
  "figure_clean_controls"
)

variant_images <- sort(list.files(
  variants_folder,
  pattern = "_variants\\.jpg$",
  full.names = TRUE,
  ignore.case = TRUE
))

autofluorescence_images <- sort(list.files(
  autofluorescence_folder,
  pattern = "\\.(jpg|jpeg|png)$",
  full.names = TRUE,
  ignore.case = TRUE
))

scatter_images <- sort(list.files(
  scatter_folder,
  pattern = "\\.(jpg|jpeg|png)$",
  full.names = TRUE,
  ignore.case = TRUE
))

similarity_images <- sort(list.files(
  similarity_folder,
  pattern = "\\.(jpg|jpeg|png)$",
  full.names = TRUE,
  ignore.case = TRUE
))

spectra_images <- sort(list.files(
  spectra_folder,
  pattern = "\\.(jpg|jpeg|png)$",
  full.names = TRUE,
  ignore.case = TRUE
))

clean_control_images <- sort(list.files(
  clean_controls_folder,
  pattern = "\\.(jpg|jpeg|png)$",
  full.names = TRUE,
  ignore.case = TRUE
))

pipeline_summary_file <- file.path(
  output_folder,
  "pipeline_summary.rds"
)

pipeline_summary <- if (file.exists(pipeline_summary_file)) {
  readRDS(pipeline_summary_file)
} else {
  NULL
}

patient_af_status_file <- file.path(
  output_folder,
  "patient_af_status.csv"
)

patient_unmixing_status_file <- file.path(
  output_folder,
  "patient_unmixing_status.csv"
)

nonpatient_unmixing_status_file <- file.path(
  output_folder,
  "nonpatient_unmixing_status.csv"
)

qc_gating_plots_file <- file.path(
  output_folder,
  "qc_gating_plots.rds"
)

patient_compensaid_file <- file.path(
  output_folder,
  "compensAID",
  "PT_compensaid_results.rds"
)

controls_compensaid_file <- file.path(
  output_folder,
  "compensAID",
  "controls_compensaid_results.rds"
)

read_status_table <- function(path) {
  if (!file.exists(path)) {
    return(NULL)
  }

  readr::read_csv(
    path,
    show_col_types = FALSE
  )
}

af_status <- read_status_table(patient_af_status_file)
patient_unmixing_status <- read_status_table(
  patient_unmixing_status_file
)
nonpatient_unmixing_status <- read_status_table(
  nonpatient_unmixing_status_file
)

gating_plots <- if (file.exists(qc_gating_plots_file)) {
  readRDS(qc_gating_plots_file)
} else {
  NULL
}

patient_compensaid_results <- if (file.exists(patient_compensaid_file)) {
  readRDS(patient_compensaid_file)
} else {
  NULL
}

controls_compensaid_results <- if (file.exists(controls_compensaid_file)) {
  readRDS(controls_compensaid_file)
} else {
  NULL
}

status_badge <- function(status) {
  if (identical(status, "completed")) {
    return("✅ Completed")
  }

  if (identical(status, "failed")) {
    return("❌ Failed")
  }

  if (identical(status, "flagged")) {
    return("⚠️ Flagged")
  }

  "Unknown"
}

count_status <- function(data, status) {
  if (is.null(data) || nrow(data) == 0) {
    return(0L)
  }

  sum(data$status == status, na.rm = TRUE)
}

compensaid_summary <- function(results) {
  if (is.null(results) || length(results) == 0) {
    return(tibble::tibble(
      sample = character(),
      flagged_pairs = integer(),
      review_status = character()
    ))
  }

  purrr::imap_dfr(
    results,
    function(result, sample_name) {
      flagged_pairs <- result$flagged_pairs

      n_flagged <- if (is.null(flagged_pairs)) {
        0L
      } else {
        nrow(flagged_pairs)
      }

      tibble::tibble(
        sample = sample_name,
        flagged_pairs = n_flagged,
        review_status = if (n_flagged > 0) {
          "Review"
        } else {
          "No flagged pairs"
        }
      )
    }
  )
}

patient_compensaid_summary <- compensaid_summary(
  patient_compensaid_results
)

controls_compensaid_summary <- compensaid_summary(
  controls_compensaid_results
)

make_image_carousel <- function(
  image_files,
  carousel_id,
  title = NULL,
  image_height = "32rem"
) {
  image_files <- image_files[file.exists(image_files)]

  if (length(image_files) == 0) {
    return(
      htmltools::HTML(
        "<p>No images were found for this section.</p>"
      )
    )
  }

  image_files <- normalizePath(
    image_files,
    winslash = "/",
    mustWork = TRUE
  )

  # Convert absolute paths to paths relative to the report directory.
  image_sources <- fs::path_rel(
    image_files,
    start = getwd()
  )

  image_sources <- gsub(
    "\\\\",
    "/",
    image_sources
  )

  escape_html <- function(x) {
    x <- gsub("&", "&amp;", x, fixed = TRUE)
    x <- gsub("<", "&lt;", x, fixed = TRUE)
    x <- gsub(">", "&gt;", x, fixed = TRUE)
    x <- gsub("\"", "&quot;", x, fixed = TRUE)
    x
  }

  slides <- purrr::map2_chr(
    image_sources,
    basename(image_files),
    function(image_source, image_label) {
      paste0(
        '<div class="qc-carousel-slide">',
        '<img src="',
        escape_html(image_source),
        '" alt="',
        escape_html(image_label),
        '" style="height:',
        image_height,
        ';">',
        '<div class="qc-carousel-caption">',
        escape_html(image_label),
        "</div>",
        "</div>"
      )
    }
  )

  title_html <- if (is.null(title)) {
    ""
  } else {
    paste0("<h4>", escape_html(title), "</h4>")
  }

  html <- paste0(
    '<div class="qc-carousel" id="',
    escape_html(carousel_id),
    '">',
    title_html,
    '<button class="qc-carousel-button previous" ',
    'type="button" aria-label="Previous image" ',
    'onclick="qcCarouselMove(\'',
    escape_html(carousel_id),
    '\', -1)">',
    "&#10094;",
    "</button>",
    '<div class="qc-carousel-window">',
    '<div class="qc-carousel-track">',
    paste(slides, collapse = ""),
    "</div>",
    "</div>",
    '<button class="qc-carousel-button next" ',
    'type="button" aria-label="Next image" ',
    'onclick="qcCarouselMove(\'',
    escape_html(carousel_id),
    '\', 1)">',
    "&#10095;",
    "</button>",
    '<div class="qc-carousel-counter">',
    "1 / ",
    length(slides),
    "</div>",
    "</div>"
  )

  htmltools::HTML(html)
}
```


